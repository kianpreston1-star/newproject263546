      "id": "2ca577104dc44d86ae500eef",
      "name": "Read config",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -290,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Flatten the key/value 'config' tab into one object.\nconst cfg = {};\nfor (const item of $input.all()) {\n  const k = (item.json.key || '').toString().trim();\n  if (!k || k.startsWith('#')) continue;\n  cfg[k] = (item.json.value === undefined || item.json.value === null) ? '' : item.json.value.toString().trim();\n}\nconst list = (s) => (cfg[s] || '').split(';').map(x => x.trim()).filter(Boolean);\ncfg._platforms = list('platforms');\ncfg._keywords = list('niche_keywords');\ncfg._fixedChannels = list('clip_fixed_channel_ids');\nreturn [{ json: { config: cfg } }];\n"
      },
      "id": "6d1551fca73247249a663ea1",
      "name": "Parse config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.config.engine2_ai }}",
              "rightValue": "ON",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "104866f5d8c8412da2b54fcc",
      "name": "Engine 2 ON?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        130,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "SET_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "queue",
          "mode": "name"
        },
        "options": {}
      },
      "id": "02a8e7616463419ea4aa674f",
      "name": "Read queue",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Take up to ai_max_per_run unused topics; attach a random variety seed each.\nconst cfg = $('Parse config').first().json.config;\nconst maxN = parseInt(cfg.ai_max_per_run || '2', 10);\nconst hooks=['curiosity_gap','contrarian','direct_promise','number_list','mistake_warning','question','story_cold_open','myth_vs_fact','before_after','shock_stat'];\nconst structs=['problem_twist_payoff','list','myth_vs_fact','story','how_it_works'];\nconst pacings=['punchy','narrative'];\nconst rand=a=>a[Math.floor(Math.random()*a.length)];\nconst rows = $('Read queue').all().map(i=>i.json).filter(r=>(r.status||'new')==='new').slice(0,maxN);\nreturn rows.map(r=>({ json: { ...r, config: cfg,\n  hook_style: rand(hooks), structure: rand(structs), pacing: rand(pacings) }}));\n"
      },
      "id": "0d832863e6834f38986e533e",
      "name": "Pick topics + variety",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        550,
        300
      ]
    },
    {
      "parameters": {
        "options": {},
        "batchSize": 1
      },
      "id": "47d865ddff3444fb823bff66",
      "name": "For each topic",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        760,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { contents: [ { parts: [ { text: 'Write a ' + ($json.config.ai_clip_length_sec||40) + 's vertical short script. Topic: ' + $json.topic + '. Hook style: ' + $json.hook_style + '. Structure: ' + $json.structure + '. Pacing: ' + $json.pacing + '. Voice: ' + ($json.config.brand_voice||'') + '. No hallucinated facts. Return ONLY JSON: {\"title\":\"...\",\"voiceover\":\"...\",\"beats\":[{\"text_on_screen\":\"...\",\"broll\":\"...\",\"seconds\":4}],\"music_mood\":\"...\"}' } ] } ] } }}",
        "options": {}
      },
      "id": "8811f181db144a7c8edd9418",
      "name": "Write script (LLM)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        970,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const t=$('For each topic').item.json;\nlet s={};\ntry { const raw=$json?.candidates?.[0]?.content?.parts?.[0]?.text||'{}';\n  s=JSON.parse(raw.replace(/```json|```/g,'').trim()); } catch(e){ s={title:t.topic,voiceover:t.topic,beats:[],music_mood:'upbeat'}; }\nreturn [{ json: { ...t, script: s, title: s.title, voiceover: s.voiceover, beats: s.beats||[] } }];\n"
      },
      "id": "e6ff817d04954d2ba1786fc0",
      "name": "Parse script",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:8880/v1/audio/speech",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'kokoro', input: $json.voiceover, voice: 'af_sky', response_format: 'mp3' } }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "8cc56bbd31954721acd94e2b",
      "name": "Voiceover (TTS)",
