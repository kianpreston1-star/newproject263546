{
  "_comment": "Creatomate render source for a vertical 9:16 short. POST as the 'source' field (or convert to a saved template + 'modifications'). {{...}} keys are filled by the n8n render node from the script-generation output. Beats are duplicated at runtime, so this shows a 3-beat skeleton you can extend.",
  "output_format": "mp4",
  "width": 1080,
  "height": 1920,
  "frame_rate": 30,
  "elements": [
    {
      "type": "audio",
      "track": 1,
      "source": "{{voiceover_url}}",
      "_comment": "TTS voiceover drives total duration; visuals/captions align to it."
    },
    {
      "type": "audio",
      "track": 2,
      "source": "{{music_url}}",
      "volume": "18%",
      "_comment": "Background music, ducked under the voice. Use a licensed/royalty-free track."
    },
    {
      "type": "composition",
      "track": 3,
      "name": "beat_1",
      "duration": "{{beat_1_seconds}}",
      "elements": [
        { "type": "video", "source": "{{broll_1_url}}", "fit": "cover", "animations": [ { "type": "scale", "scope": "element", "start_scale": "100%", "end_scale": "115%", "easing": "linear" } ] },
        { "type": "text", "text": "{{caption_1}}", "y": "82%", "width": "90%", "x_alignment": "50%", "font_family": "Montserrat", "font_weight": "800", "font_size": "8.5 vmin", "fill_color": "#ffffff", "stroke_color": "#000000", "stroke_width": "0.6 vmin", "background_color": "rgba(0,0,0,0.35)", "background_x_padding": "4%", "background_y_padding": "2%" }
      ]
    },
    {
      "type": "composition",
      "track": 3,
      "name": "beat_2",
      "duration": "{{beat_2_seconds}}",
      "elements": [
        { "type": "video", "source": "{{broll_2_url}}", "fit": "cover" },
        { "type": "text", "text": "{{caption_2}}", "y": "82%", "width": "90%", "x_alignment": "50%", "font_family": "Montserrat", "font_weight": "800", "font_size": "8.5 vmin", "fill_color": "#ffffff", "stroke_color": "#000000", "stroke_width": "0.6 vmin", "background_color": "rgba(0,0,0,0.35)", "background_x_padding": "4%", "background_y_padding": "2%" }
      ]
    },
    {
      "type": "composition",
      "track": 3,
      "name": "beat_3",
      "duration": "{{beat_3_seconds}}",
      "elements": [
        { "type": "video", "source": "{{broll_3_url}}", "fit": "cover" },
        { "type": "text", "text": "{{caption_3}}", "y": "82%", "width": "90%", "x_alignment": "50%", "font_family": "Montserrat", "font_weight": "800", "font_size": "8.5 vmin", "fill_color": "#ffffff", "stroke_color": "#000000", "stroke_width": "0.6 vmin", "background_color": "rgba(0,0,0,0.35)", "background_x_padding": "4%", "background_y_padding": "2%" }
      ]
    },
    {
      "type": "text",
      "track": 4,
      "text": "{{title}}",
      "time": 0,
      "duration": 2.5,
      "y": "16%",
      "width": "92%",
      "x_alignment": "50%",
      "font_family": "Montserrat",
      "font_weight": "900",
      "font_size": "10 vmin",
      "fill_color": "#ffffff",
      "stroke_color": "#000000",
      "stroke_width": "0.8 vmin",
      "_comment": "Hook title overlay, only on screen for the first 2.5s."
    }
  ]
}
